{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aman-adnoxy/interview-prep/blob/main/schema/curriculum.schema.json",
  "title": "Interview Prep Curriculum Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "curriculumId",
    "title",
    "description",
    "timezone",
    "progression",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "curriculumId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "missedDayBehavior",
        "ordering"
      ],
      "properties": {
        "unit": {
          "const": "section"
        },
        "missedDayBehavior": {
          "const": "resume-next-incomplete"
        },
        "ordering": {
          "const": "fixed"
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "order",
          "sections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "lessonId",
                "difficulty",
                "order",
                "prerequisites",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "lessonId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "difficulty": {
                  "enum": [
                    "beginner",
                    "intermediate",
                    "advanced"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "prerequisites": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "enum": [
                    "published",
                    "upcoming"
                  ]
                },
                "stageId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "description",
                "order"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
